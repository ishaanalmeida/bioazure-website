---
interface Props {
  principalName: string;
  principalLogo: string;
  family: string;
  description: string;
  keyProducts: string[];
  catalogueUrl: string | null;
}

const { principalName, principalLogo, family, description, keyProducts, catalogueUrl } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="flex flex-col rounded-xl border border-gray-200 bg-white p-6 transition hover:shadow-lg">
  <div class="mb-4 flex h-8 items-center">
    <img src={`${b}/logos/${principalLogo}`} alt={principalName} class="max-h-8 w-auto max-w-full object-contain object-left" loading="lazy" />
  </div>
  <h3 class="mb-2 text-lg font-semibold text-primary">{family}</h3>
  <p class="mb-4 flex-1 text-base text-gray-600">{description}</p>
  <ul class="mb-4 space-y-1">
    {keyProducts.map(p => (
      <li class="flex items-start gap-2 text-sm text-gray-500">
        <span class="mt-1 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent" />
        {p}
      </li>
    ))}
  </ul>
  <div class="mt-auto flex gap-2">
    <a href={`${b}/contact?product=${encodeURIComponent(family)}&principal=${encodeURIComponent(principalName)}`} class="flex-1 rounded-lg bg-accent px-4 py-2 text-center text-sm font-semibold text-white hover:bg-accent-dark">
      Request a Quote
    </a>
    {catalogueUrl && (
      <a href={catalogueUrl} target="_blank" rel="noopener" class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-600 hover:border-primary hover:text-primary">
        Catalogue
      </a>
    )}
  </div>
</div>
