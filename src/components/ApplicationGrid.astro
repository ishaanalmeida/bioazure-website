---
import applications from '../content/applications.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {applications.map(app => (
    <a
      href={`${b}/applications/${app.slug}`}
      class="group rounded-xl border border-gray-200 bg-white p-6 text-center transition hover:border-primary hover:shadow-lg"
    >
      <img src={`${b}/images/${app.iconFile}`} alt="" class="mx-auto mb-4 h-16 w-16" loading="lazy" />
      <h3 class="mb-2 font-semibold text-primary group-hover:text-accent">{app.title}</h3>
      <p class="text-sm text-gray-500">{app.description.split('.')[0]}.</p>
    </a>
  ))}
</div>
