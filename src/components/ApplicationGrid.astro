---
import applications from '../content/applications.json';
---

<section class="py-16">
  <div class="mx-auto max-w-7xl px-4">
    <h2 class="mb-2 text-center text-3xl font-bold text-primary">Application Areas</h2>
    <p class="mb-10 text-center text-gray-500">Solutions across diagnostics, food safety, and IVD manufacturing</p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {applications.map(app => (
        <a
          href={`/applications/${app.slug}`}
          class="group rounded-xl border border-gray-200 p-6 text-center transition hover:border-primary hover:shadow-lg"
        >
          <img src={`/images/${app.iconFile}`} alt="" class="mx-auto mb-4 h-16 w-16" loading="lazy" />
          <h3 class="mb-2 font-semibold text-primary group-hover:text-accent">{app.title}</h3>
          <p class="text-sm text-gray-500">{app.description.split('.')[0]}.</p>
        </a>
      ))}
    </div>
  </div>
</section>
