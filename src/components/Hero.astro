---
interface Props {
  title: string;
  subtitle?: string;
  imageSrc?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  overlay?: boolean;
}

const { title, subtitle, imageSrc, primaryCta, secondaryCta, overlay = true } = Astro.props;
---

<section class="relative flex min-h-[70vh] items-center bg-primary text-white">
  {imageSrc && (
    <img
      src={imageSrc}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
    />
  )}
  {overlay && <div class="absolute inset-0 bg-primary/70" />}
  <div class="relative z-10 mx-auto max-w-7xl px-4 py-20 text-center">
    <h1 class="text-4xl font-bold leading-tight md:text-5xl lg:text-6xl">{title}</h1>
    {subtitle && <p class="mx-auto mt-4 max-w-2xl text-lg opacity-90 md:text-xl">{subtitle}</p>}
    {(primaryCta || secondaryCta) && (
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        {primaryCta && (
          <a href={primaryCta.href} class="rounded-lg bg-accent px-6 py-3 font-semibold text-white transition hover:bg-accent-dark">
            {primaryCta.label}
          </a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.href} class="rounded-lg border-2 border-white px-6 py-3 font-semibold text-white transition hover:bg-white/10">
            {secondaryCta.label}
          </a>
        )}
      </div>
    )}
  </div>
</section>
