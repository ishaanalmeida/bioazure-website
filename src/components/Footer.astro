---
const year = new Date().getFullYear();
---

<footer class="bg-primary-dark text-gray-300">
  <div class="mx-auto max-w-7xl px-4 py-12">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <img src="/logos/bioazure-logo-white.svg" alt="BioAzure" class="mb-4 h-8" />
        <p class="text-sm">
          Bridging global biotech innovation to India since 2009.
        </p>
      </div>
      <div>
        <h3 class="mb-3 text-sm font-semibold text-white">Quick Links</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/products" class="hover:text-white">Products</a></li>
          <li><a href="/partners" class="hover:text-white">Partners</a></li>
          <li><a href="/applications" class="hover:text-white">Applications</a></li>
          <li><a href="/contact" class="hover:text-white">Contact</a></li>
        </ul>
      </div>
      <div>
        <h3 class="mb-3 text-sm font-semibold text-white">Contact</h3>
        <ul class="space-y-2 text-sm">
          <li>+91 98 200 33 465</li>
          <li>info@bioazure.com</li>
          <li>Mumbai, India</li>
          <li>Mon–Sat, 9:30 AM – 5:30 PM IST</li>
        </ul>
      </div>
    </div>
    <div class="mt-8 border-t border-gray-600 pt-6 text-center text-xs">
      &copy; {year} BioAzure Technologies Pvt. Ltd. All rights reserved.
    </div>
  </div>
</footer>
