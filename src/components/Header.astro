---
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const navLinks = [
  { label: 'Home', href: `${b}/` },
  { label: 'About', href: `${b}/about` },
  { label: 'Products', href: `${b}/products` },
  { label: 'Partners', href: `${b}/partners` },
  { label: 'Applications', href: `${b}/applications` },
  { label: 'Contact', href: `${b}/contact` },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white shadow-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3">
    <a href={`${b}/`} class="flex items-center gap-2">
      <img src={`${b}/logos/bioazure-logo.svg`} alt="BioAzure" class="h-10" />
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            'text-sm font-medium transition-colors hover:text-primary',
            currentPath === link.href ? 'text-primary' : 'text-gray-600',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href={`${b}/contact`}
      class="hidden rounded-lg bg-accent px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-dark md:inline-block"
    >
      Request a Quote
    </a>

    <button
      id="mobile-menu-btn"
      class="text-gray-600 md:hidden"
      aria-label="Toggle menu"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t bg-white px-4 pb-4 md:hidden">
    {navLinks.map(link => (
      <a href={link.href} class="block py-2 text-sm text-gray-600 hover:text-primary">
        {link.label}
      </a>
    ))}
    <a href={`${b}/contact`} class="mt-2 block rounded-lg bg-accent px-4 py-2 text-center text-sm font-semibold text-white">
      Request a Quote
    </a>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
