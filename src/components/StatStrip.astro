---
const stats = [
  { value: '2009', label: 'Founded in Mumbai', icon: '🏢' },
  { value: '6', label: 'European Principals', icon: '🌍' },
  { value: '13+', label: 'Cities Served', icon: '📍' },
  { value: 'PhD', label: 'Scientist-Founded', icon: '🔬' },
];
---

<section class="bg-primary py-10">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-6 px-4 text-center md:grid-cols-4">
    {stats.map(s => (
      <div class="flex flex-col items-center">
        <div class="text-3xl font-bold text-white md:text-4xl">{s.value}</div>
        <div class="mt-1 text-sm text-white/70">{s.label}</div>
      </div>
    ))}
  </div>
</section>
