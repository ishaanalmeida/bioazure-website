---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PartnerCarousel from '../components/PartnerCarousel.astro';
import ApplicationGrid from '../components/ApplicationGrid.astro';
import StatStrip from '../components/StatStrip.astro';
import copy from '../content/astra-copy.json';
---

<Base title="Home" description={copy.seoDescriptions.home}>
  <Hero
    title={copy.hero.title}
    subtitle={copy.hero.subtitle}
    imageSrc="/images/hero-biotech.webp"
    primaryCta={{ label: 'Find the Right Product', href: '/products' }}
    secondaryCta={{ label: 'Request a Quote', href: '/contact' }}
  />

  <PartnerCarousel />

  <ApplicationGrid />

  <StatStrip />

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 text-center">
      <h2 class="mb-4 text-3xl font-bold text-primary">{copy.whyBioazure.headline}</h2>
      <p class="mx-auto mb-8 max-w-2xl text-gray-600">
        {copy.whyBioazure.body}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/about" class="rounded-lg border-2 border-primary px-6 py-3 font-semibold text-primary hover:bg-primary hover:text-white">
          Our Story
        </a>
        <a href="/contact" class="rounded-lg bg-accent px-6 py-3 font-semibold text-white hover:bg-accent-dark">
          Get in Touch
        </a>
      </div>
    </div>
  </section>
</Base>
