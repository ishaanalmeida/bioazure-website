---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import IndiaMap from '../components/IndiaMap.astro';
import copy from '../content/astra-copy.json';
---

<Base title="Contact" description={copy.seoDescriptions.contact}>
  <Hero title="Get in Touch" subtitle="Request a quote, ask a product question, or reach our team directly" />

  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid gap-12 lg:grid-cols-5">
        <!-- Form -->
        <div class="lg:col-span-3">
          <h2 id="form-heading" class="mb-6 text-2xl font-bold text-primary">Send us an inquiry</h2>

          <!-- Success message, shown client-side when ?sent=true -->
          <div id="sent-banner" class="mb-6 hidden rounded-lg border border-accent/30 bg-accent/10 p-4 text-sm text-accent-dark">
            Thank you! We've received your inquiry and will respond within one business day.
          </div>

          <QuoteForm />
        </div>

        <!-- Contact details sidebar -->
        <div class="lg:col-span-2">
          <h2 class="mb-6 text-2xl font-bold text-primary">Contact Details</h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-gray-800">Phone / WhatsApp</h3>
                <a href="tel:+919820033465" class="text-gray-600 hover:text-primary">+91 98 200 33 465</a>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-gray-800">Email</h3>
                <a href="mailto:info@bioazure.com" class="text-gray-600 hover:text-primary">info@bioazure.com</a>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-gray-800">Office Hours</h3>
                <p class="text-gray-600">Monday – Saturday, 9:30 AM – 5:30 PM IST</p>
              </div>
            </div>
            <div class="flex gap-4">
              <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold text-gray-800">Address</h3>
                <p class="text-gray-600">207, Shanta Industrial Premises Co-op Soc. Ltd.<br />IB Patel Road, Goregaon East<br />Mumbai 400063, India</p>
              </div>
            </div>
          </div>

          <!-- Mini map -->
          <div class="mt-8 rounded-xl border border-gray-200 p-4">
            <IndiaMap />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const params = new URLSearchParams(window.location.search);

    // Show success banner
    if (params.get('sent') === 'true') {
      document.getElementById('sent-banner')?.classList.remove('hidden');
    }

    // Update heading if product context present
    if (params.get('product')) {
      const heading = document.getElementById('form-heading');
      if (heading) heading.textContent = 'Request a Quote';
    }
  });
</script>
