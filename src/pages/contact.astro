---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import copy from '../content/astra-copy.json';

const sent = Astro.url.searchParams.get('sent') === 'true';
---

<Base title="Contact" description={copy.seoDescriptions.contact}>
  <Hero title="Get in Touch" subtitle="Request a quote, ask a product question, or reach our team directly" />

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid gap-12 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <h2 class="mb-6 text-2xl font-bold text-primary">Send us an inquiry</h2>
          {sent && (
            <div class="mb-6 rounded-lg border border-accent/30 bg-accent/10 p-4 text-sm text-accent-dark">
              Thank you! We've received your inquiry and will respond within one business day.
            </div>
          )}
          <QuoteForm />
        </div>
        <div class="lg:col-span-2">
          <h2 class="mb-6 text-2xl font-bold text-primary">Contact Details</h2>
          <div class="space-y-4 text-gray-600">
            <div>
              <h3 class="text-sm font-semibold text-gray-800">Phone / WhatsApp</h3>
              <p>+91 98 200 33 465</p>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-gray-800">Email</h3>
              <p><a href="mailto:info@bioazure.com" class="text-primary hover:underline">info@bioazure.com</a></p>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-gray-800">Office Hours</h3>
              <p>Monday – Saturday, 9:30 AM – 5:30 PM IST</p>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-gray-800">Address</h3>
              <p>207, Shanta Industrial Premises Co-op Soc. Ltd.<br />IB Patel Road, Goregaon East<br />Mumbai 400063, India</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
