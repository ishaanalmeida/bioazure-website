---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import partners from '../content/partners.json';
import copy from '../content/astra-copy.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Partners" description={copy.seoDescriptions.partners}>
  <Hero
    title="Our Global Partners"
    subtitle="Six European principals, each a specialist in their field"
    imageSrc={`${b}/images/partners-banner.webp`}
  />

  <section class="py-20">
    <div class="mx-auto max-w-5xl space-y-8 px-4">
      {partners.map((partner, i) => (
        <div class="fade-in overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition hover:shadow-md">
          <div class:list={['flex flex-col md:flex-row', i % 2 !== 0 && 'md:flex-row-reverse']}>
            <div class="flex flex-shrink-0 items-center justify-center bg-surface p-8 md:w-56">
              <img src={`${b}/logos/${partner.logoFile}`} alt={partner.name} class="max-h-20 w-auto" loading="lazy" />
            </div>
            <div class="flex-1 p-8">
              <div class="mb-3 flex flex-wrap items-center gap-3">
                <h2 class="text-xl font-bold text-primary">{partner.name}</h2>
                <span class="rounded-full bg-primary/10 px-3 py-0.5 text-xs font-medium text-primary">{partner.country}</span>
              </div>
              <p class="mb-4 text-gray-600">{partner.description}</p>
              <p class="mb-5 text-sm text-gray-500"><span class="font-medium text-gray-700">Products:</span> {partner.products}</p>
              <div class="flex flex-wrap gap-2">
                <a href={`${b}/products?principal=${partner.id}`} class="rounded-lg bg-accent px-4 py-2 text-sm font-semibold text-white transition hover:bg-accent-dark">
                  View Products
                </a>
                {partner.catalogueUrl && (
                  <a href={partner.catalogueUrl} target="_blank" rel="noopener" class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-600 transition hover:border-primary hover:text-primary">
                    Download Catalogue
                  </a>
                )}
                <a href={partner.website} target="_blank" rel="noopener" class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-600 transition hover:border-primary hover:text-primary">
                  Website &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-primary py-16">
    <div class="mx-auto max-w-7xl px-4 text-center">
      <h2 class="mb-4 text-2xl font-bold text-white">Interested in our product range?</h2>
      <p class="mx-auto mb-8 max-w-xl text-white/80">Get pricing, availability, and technical support for any product from our six principals.</p>
      <a href={`${b}/contact`} class="inline-block rounded-lg bg-accent px-8 py-3 font-semibold text-white transition hover:bg-accent-dark">
        Request a Quote
      </a>
    </div>
  </section>
</Base>
