---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StatStrip from '../components/StatStrip.astro';
import IndiaMap from '../components/IndiaMap.astro';
import copy from '../content/astra-copy.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="About" description={copy.seoDescriptions.about}>
  <Hero title="Our Story" subtitle="From two PhDs in Mumbai to a pan-India diagnostics distribution network" />

  <!-- Story with image -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="fade-in grid items-center gap-12 lg:grid-cols-2">
        <div class="space-y-5 text-lg leading-relaxed text-gray-700">
          <p>{copy.aboutStory[0]}</p>
          <p>{copy.aboutStory[1]}</p>
        </div>
        <div class="overflow-hidden rounded-2xl shadow-lg">
          <img src={`${b}/images/about-founders.webp`} alt="Dr. Adrian Almeida and Dr. Asha Kulkarni Almeida, founders of BioAzure" class="h-full w-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Continued story -->
  <section class="bg-surface py-20">
    <div class="fade-in mx-auto max-w-3xl px-4">
      <div class="space-y-5 text-lg leading-relaxed text-gray-700">
        <p>{copy.aboutStory[2]}</p>
        <p>{copy.aboutStory[3]}</p>
      </div>
    </div>
  </section>

  <!-- Founders -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="fade-in mb-12 text-center">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-accent">Leadership</p>
        <h2 class="text-3xl font-bold text-primary">Our Founders</h2>
      </div>
      <div class="mx-auto grid max-w-3xl gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center shadow-sm">
          <img src={`${b}/images/founder-adrian.jpg`} alt="Dr. Adrian Almeida" class="mx-auto mb-4 h-28 w-28 rounded-full object-cover shadow-md" />
          <h3 class="text-lg font-semibold text-primary">Dr. Adrian Almeida</h3>
          <p class="mb-3 text-sm text-gray-500">Co-Founder & Director</p>
          <p class="text-base text-gray-600">Over 29 years in life sciences and a Ph.D in Molecular Immunology, with postdoctoral research in France and Canada. He has launched more than 150 products from over 30 international principals into India and drives the adoption of molecular diagnostics here.</p>
          <a href="https://www.linkedin.com/in/dr-adrian-almeida-012b69254/" target="_blank" rel="noopener" aria-label="Dr. Adrian Almeida on LinkedIn" class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-accent">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M4.98 3.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.3c0-1.26-.02-2.9-1.9-2.9-1.9 0-2.2 1.4-2.2 2.8V21H9z"/></svg>
            LinkedIn
          </a>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center shadow-sm">
          <img src={`${b}/images/founder-asha.jpg`} alt="Dr. Asha Kulkarni Almeida" class="mx-auto mb-4 h-28 w-28 rounded-full object-cover shadow-md" />
          <h3 class="text-lg font-semibold text-primary">Dr. Asha Kulkarni Almeida</h3>
          <p class="mb-3 text-sm text-gray-500">Co-Founder & Director</p>
          <p class="text-base text-gray-600">A Ph.D in Microbiology with over 20 years in pharmaceutical drug discovery, with deep expertise in immunology and assay development. Her career spans academic research to drug discovery, and she holds 20 peer-reviewed publications and 11 patents.</p>
          <a href="https://www.linkedin.com/in/asha-a-a3b1418" target="_blank" rel="noopener" aria-label="Dr. Asha Kulkarni Almeida on LinkedIn" class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-accent">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M4.98 3.5a2.5 2.5 0 100 5 2.5 2.5 0 000-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.75V21h-4v-5.3c0-1.26-.02-2.9-1.9-2.9-1.9 0-2.2 1.4-2.2 2.8V21H9z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>

  <StatStrip />

  <!-- India map -->
  <section id="reach" class="py-20">
    <div class="mx-auto max-w-7xl px-4">
      <div class="fade-in grid items-center gap-12 lg:grid-cols-2">
        <div>
          <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-accent">Distribution Network</p>
          <h2 class="mb-6 text-3xl font-bold text-primary">Pan-India Reach</h2>
          <p class="mb-6 text-gray-600">We ship temperature-controlled consignments to laboratories, hospitals, and manufacturers across India. Mumbai is our headquarters; our distribution network reaches 13+ cities from Delhi to Cochin.</p>
          <ul class="space-y-3 text-base text-gray-600">
            <li class="flex items-center gap-3">
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </span>
              Cold-chain delivery with temperature monitoring
            </li>
            <li class="flex items-center gap-3">
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </span>
              Regulatory documentation for every product
            </li>
            <li class="flex items-center gap-3">
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-accent/10 text-accent">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              </span>
              Technical support from people who know the products
            </li>
          </ul>
        </div>
        <IndiaMap />
      </div>
    </div>
  </section>

  <!-- Who we serve -->
  <section class="bg-surface py-20">
    <div class="fade-in mx-auto max-w-7xl px-4 text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-accent">Our Customers</p>
      <h2 class="mb-10 text-3xl font-bold text-primary">Who We Serve</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { label: 'Referral Laboratories', desc: 'High-volume testing facilities across India' },
          { label: 'Multispecialty Hospitals', desc: 'In-house diagnostics departments' },
          { label: 'Government Institutions', desc: 'Public health labs and research bodies' },
          { label: 'Channel Distributors', desc: 'Regional sub-distributors and dealers' },
          { label: 'Educational Institutions', desc: 'University labs and training centres' },
          { label: 'Food Companies', desc: 'Manufacturers, exporters, and testing labs' },
        ].map(seg => (
          <div class="rounded-xl border border-gray-200 bg-white p-6 text-left shadow-sm">
            <h3 class="mb-1 font-semibold text-primary">{seg.label}</h3>
            <p class="text-base text-gray-500">{seg.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
