---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StatStrip from '../components/StatStrip.astro';
import IndiaMap from '../components/IndiaMap.astro';
import copy from '../content/astra-copy.json';
---

<Base title="About" description={copy.seoDescriptions.about}>
  <Hero title="Our Story" subtitle="A dream to transform biotechnology — from Mumbai to all of India" />

  <section class="py-16">
    <div class="mx-auto max-w-3xl px-4">
      <div class="space-y-4 text-lg leading-relaxed text-gray-700">
        {copy.aboutStory.map(paragraph => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="mb-2 text-center text-3xl font-bold text-primary">Our Founders</h2>
      <p class="mb-10 text-center text-gray-500">Built on scientific expertise and industry experience</p>
      <div class="mx-auto grid max-w-3xl gap-8 md:grid-cols-2">
        <div class="rounded-xl bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-primary text-2xl font-bold text-white">AA</div>
          <h3 class="font-semibold text-primary">Dr. Adrian Almeida</h3>
          <p class="text-sm text-gray-500">Co-Founder & Director</p>
        </div>
        <div class="rounded-xl bg-white p-6 text-center shadow-sm">
          <div class="mx-auto mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-accent text-2xl font-bold text-white">AK</div>
          <h3 class="font-semibold text-primary">Dr. Asha Kulkarni Almeida</h3>
          <p class="text-sm text-gray-500">Co-Founder & Director</p>
        </div>
      </div>
    </div>
  </section>

  <StatStrip />

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="mb-2 text-center text-3xl font-bold text-primary">Pan-India Reach</h2>
      <p class="mb-8 text-center text-gray-500">Distribution and support network across major Indian cities</p>
      <IndiaMap />
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="mb-8 text-center text-3xl font-bold text-primary">Who We Serve</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {['Referral Laboratories', 'Multispecialty Hospitals', 'Government Organizations', 'Channel Distributors', 'Educational Institutions', 'Food Companies & Exporters'].map(seg => (
          <div class="rounded-lg border border-gray-200 px-4 py-3 text-center text-sm font-medium text-gray-600">
            {seg}
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
