---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ProductCard from '../../components/ProductCard.astro';
import applications from '../../content/applications.json';
import products from '../../content/products.json';
import partners from '../../content/partners.json';
import copy from '../../content/astra-copy.json';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const app = applications.find(a => a.slug === 'molecular-diagnostics')!;
const appProducts = products.filter(p => p.application === app.slug);
---

<Base title={app.title} description={copy.seoDescriptions['molecular-diagnostics']}>
  <Hero title={app.title} subtitle={app.description} />

  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4">
      <div class="fade-in mb-10">
        <h2 class="mb-4 text-2xl font-bold text-primary">Who uses these products</h2>
        <div class="flex flex-wrap gap-2">
          {app.customerTypes.map(ct => (
            <span class="rounded-full bg-primary/10 px-4 py-1.5 text-sm font-medium text-primary">{ct}</span>
          ))}
        </div>
      </div>

      <h2 class="mb-6 text-2xl font-bold text-primary">Available Products</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {appProducts.map(prod => {
          const partner = partners.find(p => p.id === prod.principalId)!;
          return (
            <ProductCard
              principalName={partner.name}
              principalLogo={partner.logoFile}
              family={prod.family}
              description={prod.description}
              keyProducts={prod.keyProducts}
              catalogueUrl={prod.catalogueUrl}
            />
          );
        })}
      </div>

      <div class="mt-12 rounded-xl bg-surface p-8 text-center">
        <h3 class="mb-2 text-lg font-semibold text-primary">Need help choosing the right product?</h3>
        <p class="mb-4 text-base text-gray-600">Tell us about your lab setup and testing needs — we'll recommend the best solution.</p>
        <a href={`${b}/contact?product=${encodeURIComponent(app.title)}`} class="inline-block rounded-lg bg-accent px-6 py-3 font-semibold text-white transition hover:bg-accent-dark">
          Request a Quote for {app.title}
        </a>
      </div>
    </div>
  </section>
</Base>
